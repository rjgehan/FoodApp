{
  "name": "mealplanner-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "reset": "bash scripts/reset-local.sh",
    "seed": "node scripts/seed-demo.mjs",
    "seed:showcase": "node scripts/seed-showcase.mjs",
    "test": "playwright test --project=api --project=iphone",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=iphone",
    "screens": "playwright test --project=screens && node scripts/build-pdf.mjs",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "^22.0.0"
  }
}
