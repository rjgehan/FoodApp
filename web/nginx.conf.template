# React Router is client-side, and the API is reached through this same server on /api —
# so the browser only ever talks to one origin and one port. No CORS, and no API URL baked
# into the bundle at build time.

# WebSocket upgrades need this mapping; conf.d files are included inside `http`, so a `map`
# at the top of the file is in the right place.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Docker's embedded DNS, read from the container's own resolv.conf by the nginx image's
    # 15-local-resolvers.envsh. Hard-coding 127.0.0.11 breaks on any network that lacks it.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    location /api/ {
        # Going through a variable forces per-request resolution. With a literal name here,
        # nginx resolves once at boot and REFUSES TO START if the backend isn't up yet —
        # one slow container takes the whole site down, which is not what you want on a box
        # that reboots. This way the UI still serves while the backend is booting.
        set $mp_backend "backend:8080";
        proxy_pass http://$mp_backend$request_uri;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Recipe photos are downscaled to ~200KB in the browser, but nginx's 1MB default
        # would still reject the larger ones. The backend caps uploads at 3MB.
        client_max_body_size 8m;
    }

    location /ws/ {
        set $mp_backend_ws "backend:8080";
        proxy_pass http://$mp_backend_ws$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;

        # SockJS falls back to long-polling when a socket isn't available; buffering would
        # stall those streams.
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
