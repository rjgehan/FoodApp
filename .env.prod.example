# Copy to .env on the server and fill in. .env is gitignored — never commit the real one.
#   cp .env.prod.example .env

# Generate with:  openssl rand -hex 32
# Use hex, not base64: compose treats `$` in a value as a variable and silently eats the rest
# of it, so a base64 secret can arrive shorter than you wrote it. Hex has no special characters.
JWT_SECRET=change-me-run-openssl-rand-hex-32

# Postgres credentials. DB_PASSWORD is baked into the database the FIRST time it starts and
# is never re-read. Changing it later leaves the backend unable to log in ("password
# authentication failed"). To change it afterwards you must either wipe the data directory or
#   ALTER USER mealplanner WITH PASSWORD '<new>';
# Generate with:  openssl rand -hex 24
DB_PASSWORD=change-me-run-openssl-rand-hex-24
DB_USER=mealplanner
DB_NAME=mealplanner

# Your GitHub username — the GHCR namespace the images were pushed to.
GHCR_OWNER=rjgehan

# `latest`, or a commit SHA to pin/roll back to a specific build.
IMAGE_TAG=latest

# The only port the app needs. 80 needs root; on CasaOS use 8090, since 80 is the dashboard.
WEB_PORT=80

# Optional. Set this and the recipe page can write a recipe from a name and a serving count.
# Unset means the feature is hidden entirely. Get one from aistudio.google.com.
GEMINI_API_KEY=
