# Copy to .env on the server and fill in. .env is gitignored — never commit the real one.
#   cp .env.prod.example .env

# Long random string. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Postgres credentials. Changing DB_PASSWORD after the first start does NOT change it in
# the existing volume — set it once, before the first `docker compose up`.
DB_PASSWORD=change-me
DB_USER=mealplanner
DB_NAME=mealplanner

# Your GitHub username — the GHCR namespace the images were pushed to.
GHCR_OWNER=rjgehan

# `latest`, or a commit SHA to pin/roll back to a specific build.
IMAGE_TAG=latest

# The only port the app needs. 80 needs root; on CasaOS use 8090, since 80 is the dashboard.
WEB_PORT=80
