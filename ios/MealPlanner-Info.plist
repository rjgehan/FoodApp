<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The dev backend is plain http on localhost, and the house server is http on the LAN.
	  NSAllowsLocalNetworking permits exactly that and nothing on the open internet, so
	  meals.gehan.cloud still has to be https.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>cloud.gehan.mealplanner</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mealplanner</string>
			</array>
		</dict>
	</array>
	<!--
	  Answers App Store Connect's export-compliance question at upload instead of by hand
	  every time. False is correct here: the app uses nothing but HTTPS, which is exempt.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!--
	  Required before the camera or the photo library can be opened at all: without these
	  the app does not ask, it crashes on the tap.
	-->
	<key>NSCameraUsageDescription</key>
	<string>To take a photo of a dish for its recipe.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>To use one of your photos as a recipe's picture.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Meal Planner talks to the kitchen server on your home network.</string>
</dict>
</plist>
